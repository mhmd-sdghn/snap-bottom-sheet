{"nodes": [{"id": "readme_snap_bottom_sheet", "label": "Snap Bottom Sheet (public README)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consumer-facing docs: lightweight customizable React bottom sheet with dynamic height, scroll management, SSR compatibility, TypeScript-first, CJS/ESM."}, {"id": "readme_sheet_props", "label": "Sheet root component props", "file_type": "concept", "source_file": "README.md", "source_location": "Core Components / Sheet", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public props: isOpen (required), snapPoints, activeSnapPointIndex, onClose (required), onSnap (required), noInitialAnimation. Controlled API \u2014 the consumer owns open state and the active index."}, {"id": "readme_sheet_container_props", "label": "Sheet.Container props (style, className, wrapper)", "file_type": "concept", "source_file": "README.md", "source_location": "Core Components / Sheet.Container", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "wrapper takes a ref to render in a custom container instead of portaling to document.body."}, {"id": "readme_snap_points_explained", "label": "Snap points: pixels, percentages, dynamic", "file_type": "concept", "source_file": "README.md", "source_location": "Snap Points Explained", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documented consumer semantics: 200 means 200px from the bottom, 0.5 means 50% of viewport height, SnapPointDynamicValue defers to measured content. Advanced entries are objects with value, scroll and drag."}, {"id": "readme_dynamic_height_usage", "label": "Dynamic height handling usage", "file_type": "concept", "source_file": "README.md", "source_location": "Key Features Deep Dive / Dynamic Height Handling", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content whose height changes internally is wrapped in Sheet.DynamicHeight so the sheet re-measures instead of the consumer recomputing snap points."}, {"id": "readme_scroll_management", "label": "Per-snap scroll management usage", "file_type": "concept", "source_file": "README.md", "source_location": "Key Features Deep Dive / Scroll Management", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scroll is opt-in per snap point via { value, scroll: true } rather than a sheet-wide flag."}, {"id": "readme_drag_behavior_control", "label": "Drag direction locks (drag.up / drag.down)", "file_type": "concept", "source_file": "README.md", "source_location": "Key Features Deep Dive / Drag Behavior Control", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-snap drag locks (e.g. { drag: { up: false } }) let a snap act as a ceiling or floor without extra props."}, {"id": "readme_custom_positioning", "label": "Custom positioning via wrapper ref", "file_type": "concept", "source_file": "README.md", "source_location": "Key Features Deep Dive / Custom Positioning", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passing wrapper={ref} renders the sheet inside a consumer-owned element instead of portaling to body, for embedding inside a phone frame or a panel."}, {"id": "readme_ssr_compatibility", "label": "SSR compatibility claims", "file_type": "concept", "source_file": "README.md", "source_location": "SSR Considerations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automatic portal handling, no hydration mismatches, graceful fallbacks \u2014 implemented by the isSSR branch that emits plain markup with no portal."}, {"id": "readme_styling_hooks", "label": "Styling hooks (.snap-bottom-sheet-container / -content)", "file_type": "concept", "source_file": "README.md", "source_location": "Styling Tips", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documented stable class names consumers override for shadow, radius and transitions; treating them as public API means renaming them is a breaking change."}, {"id": "readme_best_practices", "label": "Consumer best practices", "file_type": "rationale", "source_file": "README.md", "source_location": "Best Practices", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SnapPointDynamicValue first when using dynamic content, percentages for responsive layouts, wrap height-changing content, noInitialAnimation for modals from instant actions, mix pixel and percentage snaps for hybrid layouts."}], "edges": [{"source": "readme_snap_bottom_sheet", "target": "readme_sheet_props", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Core Components", "weight": 1.0}, {"source": "readme_sheet_props", "target": "lib_components_sheet_sheet", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Core Components / Sheet", "weight": 1.0}, {"source": "readme_sheet_container_props", "target": "lib_components_sheetcontainer_sheetcontainer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Core Components / Sheet.Container", "weight": 1.0}, {"source": "readme_snap_points_explained", "target": "lib_constants_snappointdynamicvalue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Snap Points Explained", "weight": 1.0}, {"source": "readme_snap_points_explained", "target": "lib_utils_getsnapvalues", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_locati