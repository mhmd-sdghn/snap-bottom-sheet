{
  "name": "snap-bottom-sheet-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "build": "pnpm --filter snap-bottom-sheet build",
    "dev": "pnpm --filter snap-bottom-sheet dev",
    "test": "pnpm --filter snap-bottom-sheet test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm --filter snap-bottom-sheet typecheck",
    "docs:dev": "pnpm --filter snap-bottom-sheet-docs docs:dev",
    "docs:build": "pnpm --filter snap-bottom-sheet-docs docs:build",
    "verify:pkg": "pnpm --filter snap-bottom-sheet verify:pkg",
    "changeset": "changeset",
    "release": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:pkg && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.29.0",
    "lefthook": "^1.11.0"
  }
}
