{
  "name": "snap-bottom-sheet-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm --filter snap-bottom-sheet build",
    "dev": "pnpm --filter snap-bottom-sheet dev",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter snap-bottom-sheet-docs typecheck",
    "docs:dev": "pnpm --filter snap-bottom-sheet-docs docs:dev",
    "docs:build": "pnpm --filter snap-bottom-sheet-docs docs:build",
    "docs:preview": "pnpm --filter snap-bottom-sheet-docs docs:preview",
    "site:build": "pnpm docs:build && PLAYGROUND_BASE=/snap-bottom-sheet/playground/ pnpm --filter playground-react build && rm -rf docs/.vitepress/dist/playground && cp -R playgrounds/react/dist docs/.vitepress/dist/playground",
    "site:preview": "pnpm docs:preview",
    "verify:pkg": "pnpm --filter snap-bottom-sheet verify:pkg",
    "check:dist": "pnpm --filter snap-bottom-sheet check:dist",
    "changeset": "changeset",
    "release": "pnpm build && pnpm typecheck && pnpm test && pnpm check:dist && pnpm verify:pkg && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "lefthook": "^2.1.12"
  }
}
