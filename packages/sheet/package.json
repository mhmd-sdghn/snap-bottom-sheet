{
  "name": "snap-bottom-sheet",
  "version": "0.0.10",
  "description": "Framework-agnostic bottom sheet engine with React bindings: snap points, live-measured header/content snaps, scroll-aware dragging",
  "type": "module",
  "license": "MIT",
  "author": "Mo Sadeghian <mo.sdghn@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhmd-sdghn/react-bottom-sheet.git",
    "directory": "packages/sheet"
  },
  "homepage": "https://mhmd-sdghn.github.io/react-bottom-sheet",
  "bugs": "https://github.com/mhmd-sdghn/react-bottom-sheet/issues",
  "keywords": [
    "bottom-drawer",
    "bottom-sheet",
    "bottomsheet",
    "mobile-drawer",
    "mobile-bottom-sheet",
    "drawer",
    "dialog",
    "popup",
    "react",
    "modal",
    "overlay",
    "draggableview",
    "vanilla",
    "headless",
    "typescript"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size.mjs",
    "typecheck": "tsc --noEmit",
    "verify:pkg": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./package.json"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@snap-bottom-sheet/gesture": "workspace:*",
    "@snap-bottom-sheet/spring": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^26.0.0",
    "publint": "^0.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsdown": "^0.22.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
