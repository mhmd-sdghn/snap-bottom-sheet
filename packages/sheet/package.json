{
  "name": "snap-bottom-sheet",
  "version": "0.0.10",
  "description": "Draggable, snappable bottom sheet for React.",
  "type": "module",
  "license": "MIT",
  "author": "Mo Sadeghian <mo.sdghn@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhmd-sdghn/react-bottom-sheet.git",
    "directory": "packages/sheet"
  },
  "homepage": "https://mhmd-sdghn.github.io/react-bottom-sheet",
  "bugs": "https://github.com/mhmd-sdghn/react-bottom-sheet/issues",
  "keywords": [
    "bottom-drawer",
    "bottom-sheet",
    "bottomsheet",
    "mobile-drawer",
    "mobile-bottom-sheet",
    "drawer",
    "dialog",
    "popup",
    "react",
    "modal",
    "overlay",
    "draggableview"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:pkg": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./package.json"
  },
  "dependencies": {
    "@react-spring/web": "^9.7.5",
    "@use-gesture/react": "^10.3.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^26.0.0",
    "publint": "^0.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsdown": "^0.22.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
